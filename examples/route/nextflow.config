plugins {
    id 'nf-jev@0.1.0'
}

// The credential falls back to the TYPESAFE_API_KEY environment variable, so this block is only
// needed to override it -- or to pin a model snapshot, or to turn on caching.
//
// jev {
//     apiKey   = secrets.TYPESAFE_API_KEY
//     model    = 'jev-1.13.0'
//     cacheDir = "$projectDir/.jev-cache"
// }

params {
    floor = 0.70
}
