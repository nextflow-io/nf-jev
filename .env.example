# Local, untracked settings for this project. Copy to `.env` and fill in:
#
#     cp .env.example .env
#
# `make` sources `.env` into the environment of the command it runs, so nothing needs to be
# exported into your shell. `.env` is gitignored - never commit it.

# Nextflow Registry token, used by `make release`.
NPR_API_KEY=

# Registry endpoint. Leave unset for production (https://registry.nextflow.io/api).
#NPR_API_URL=

# TypeSafe credential, used when running the examples.
TYPESAFE_API_KEY=
